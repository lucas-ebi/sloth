{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "urn:sloth:schemas:mmcif_json_flat_schema",
    "title": "SLOTH mmCIF Flat JSON Schema",
    "description": "Structural schema for flat JSON format produced by SLOTH exporter. This represents the traditional mmCIF table structure where each category contains arrays of values for each field. Uses mmCIF naming conventions with data_ and _ prefixes to match the external API. Validates only JSON structure/topology, not mmCIF content semantics. Content validation is handled by PDBML XSD schema.",
    "type": "object",
    "patternProperties": {
        "^data_[a-zA-Z][a-zA-Z0-9_]*$": {
            "description": "Data block name with data_ prefix (e.g., 'data_DEMO', 'data_1ABC', 'data_test')",
            "type": "object",
            "patternProperties": {
                "^_[a-zA-Z][a-zA-Z0-9_]*$": {
                    "description": "mmCIF category with underscore prefix (e.g., '_atom_site', '_entity', '_entry')",
                    "oneOf": [
                        {
                            "description": "Single-row category (non-loop)",
                            "type": "object",
                            "patternProperties": {
                                "^[a-zA-Z][a-zA-Z0-9_]*$": {
                                    "description": "mmCIF item name",
                                    "type": "string"
                                }
                            },
                            "additionalProperties": false,
                            "minProperties": 1
                        },
                        {
                            "description": "Multi-row category (loop)",
                            "type": "array",
                            "items": {
                                "type": "object",
                                "patternProperties": {
                                    "^[a-zA-Z][a-zA-Z0-9_]*$": {
                                        "description": "mmCIF item value",
                                        "type": "string"
                                    }
                                },
                                "additionalProperties": false,
                                "minProperties": 1
                            },
                            "minItems": 1
                        }
                    ]
                }
            },
            "additionalProperties": false,
            "minProperties": 1
        }
    },
    "additionalProperties": false,
    "minProperties": 1
}
